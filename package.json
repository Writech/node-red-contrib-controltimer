{
    "name": "node-red-contrib-controltimer",
    "version": "0.4.1",
    "description": "A controllable Node-RED timer node. Start, Stop, Reset, Pause and Continue the timer. Use the timer as a loop or a delay.",
    "scripts": {
        "build": "./scripts/build.sh",
        "compile": "./scripts/compile.sh",
        "build:copy-icons": "./scripts/build/copy-icons.sh",
        "build:render-html": "./scripts/build/render-html.sh",
        "clean:all": "./scripts/clean/all.sh",
        "clean:artifacts": "./scripts/clean/artifacts.sh",
        "dev": "./scripts/dev.sh",
        "node-red:reinstall-package": "./scripts/node-red/reinstall-package.sh",
        "node-red:start-docker": "./scripts/node-red/start-docker.sh",
        "node-red:stop-docker": "./scripts/node-red/stop-docker.sh",
        "npm:publish": "./scripts/npm/publish.sh",
        "test": "./scripts/test/all.sh",
        "test:integration": "./scripts/test/integration.sh",
        "test:unit": "./scripts/test/unit.sh",
        "test:coverage": "./scripts/test/coverage.sh",
        "test:build": "./scripts/test/build.sh",
        "format": "./scripts/format.sh",
        "typecheck:tests": "./scripts/typecheck/tests.sh",
        "lint": "./scripts/lint.sh",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@changesets/cli": "^3.0.3",
        "@types/ejs": "^3.1.5",
        "@types/node": "^26.6.5",
        "@types/node-red": "^1.3.5",
        "concurrently": "^10.0.6",
        "ejs": "^7.0.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "node-red": "^5.0.9",
        "node-red-node-test-helper": "^0.3.6",
        "nodemon": "^3.1.14",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "i18next": {
            "typescript": "$typescript"
        }
    },
    "homepage": "https://github.com/Writech/node-red-contrib-controltimer#readme",
    "bugs": {
        "url": "https://github.com/Writech/node-red-contrib-controltimer/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Writech/node-red-contrib-controltimer.git"
    },
    "author": "Robert Vane <robertvane@gmail.com>",
    "license": "MIT",
    "keywords": [
        "node-red",
        "timer",
        "delay",
        "loop",
        "timeout",
        "interval"
    ],
    "node-red": {
        "version": ">=3.0.0",
        "nodes": {
            "controltimer": "dist/controltimer.js"
        }
    },
    "engines": {
        "node": ">=18"
    },
    "files": [
        "dist",
        "examples",
        "CHANGELOG.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "lint-staged": {
        "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    }
}
